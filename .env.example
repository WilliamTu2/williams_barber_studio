# Copy to .env. Local mode works without credentials.
PORT=3000
DATA_MODE=local
BUSINESS_TIMEZONE=America/Los_Angeles

# Optional production database: change DATA_MODE=supabase and configure both below.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional real notification emails (do not commit credentials).
RESEND_API_KEY=
RESEND_FROM_EMAIL=William's Barber Studio <bookings@your-verified-domain.com>
BARBER_NOTIFICATION_EMAIL=

# Owner schedule editor at /admin.html (choose a long private random value).
ADMIN_KEY=
